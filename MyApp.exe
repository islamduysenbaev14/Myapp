
import tkinter as tk
from tkinter import messagebox
import requests
import os
import sys
import subprocess

VERSION = "1.0.3"
VERSION_URL = (
    "https://raw.githubusercontent.com/"
    "islamduysenbaev14/Myapp/main/version.json"
)



def check_update():

    try:
        response = requests.get(
            VERSION_URL,
            timeout=10
        )

        response.raise_for_status()

        data = response.json()

        latest_version = data["version"]
        download_url = data["download_url"]

        if latest_version == VERSION:

            messagebox.showinfo(
                "Yangilanish",
                f"Sizda eng so‘nggi versiya o‘rnatilgan.\n\n"
                f"Joriy versiya: {VERSION}"
            )

            return

        result = messagebox.askyesno(
            "Yangi versiya mavjud",
            f"Joriy versiya: {VERSION}\n"
            f"Yangi versiya: {latest_version}\n\n"
            "Yangilashni boshlaysizmi?"
        )

        if result:
            download_update(download_url)

    except requests.RequestException as e:

        messagebox.showerror(
            "Internet xatosi",
            f"Yangilanishni tekshirishda xatolik:\n\n{e}"
        )

    except Exception as e:

        messagebox.showerror(
            "Xatolik",
            f"Yangilanishni tekshirishda xatolik:\n\n{e}"
        )


def download_update(url):

    try:

        app_folder = os.path.dirname(
            os.path.abspath(sys.executable)
        )

        new_file = os.path.join(
            app_folder,
            "MyApp_new.exe"
        )

        old_file = os.path.join(
            app_folder,
            "MyApp.exe"
        )

        updater_file = os.path.join(
            app_folder,
            "Updater.exe"
        )

        update_button.config(
            state="disabled",
            text="Yuklanmoqda..."
        )

        window.update()

        response = requests.get(
            url,
            stream=True,
            timeout=120
        )

        response.raise_for_status()

        total_size = int(
            response.headers.get(
                "content-length",
                0
            )
        )

        downloaded = 0

        with open(new_file, "wb") as file:

            for chunk in response.iter_content(
                chunk_size=1024 * 64
            ):

                if chunk:

                    file.write(chunk)

                    downloaded += len(chunk)

                    if total_size:

                        percent = int(
                            downloaded * 100 / total_size
                        )

                        update_button.config(
                            text=f"Yuklanmoqda... {percent}%"
                        )

                        window.update()

        if not os.path.exists(updater_file):

            messagebox.showerror(
                "Xatolik",
                "Updater.exe topilmadi.\n\n"
                "Updater.exe MyApp.exe bilan bir papkada "
                "bo‘lishi kerak."
            )

            if os.path.exists(new_file):
                os.remove(new_file)

            update_button.config(
                state="normal",
                text="Yangilanishni tekshirish"
            )

            return

        messagebox.showinfo(
            "Yangilanish",
            "Yangilanish yuklandi.\n"
            "Dastur qayta ishga tushadi."
        )

        subprocess.Popen([
            updater_file,
            old_file,
            new_file
        ])

        window.destroy()

    except Exception as e:

        messagebox.showerror(
            "Yangilashda xatolik",
            str(e)
        )

        update_button.config(
            state="normal",
            text="Yangilanishni tekshirish"
        )


window = tk.Tk()

window.title("MyApp")
window.geometry("500x350")
window.resizable(False, False)

title = tk.Label(
    window,
    text="Mening dasturim",
    font=("Arial", 24)
)

title.pack(pady=50)

version = tk.Label(
    window,
    text=f"Versiya: {VERSION}",
    font=("Arial", 11)
)

version.pack()

update_button = tk.Button(
    window,
    text="Yangilanishni tekshirish",
    command=check_update,
    font=("Arial", 11),
    width=25
)

update_button.pack(pady=30)

window.mainloop()
