import tkinter as tk
from tkinter import messagebox
import requests
import os
import sys
import subprocess

VERSION = "1.0.0"

VERSION_URL = "https://raw.githubusercontent.com/islamduysenbaev14/Myapp/refs/heads/main/version.json"


def check_update():

    try:
        response = requests.get(VERSION_URL, timeout=5)
        data = response.json()

        latest_version = data["version"]
        download_url = data["download_url"]

        if VERSION == latest_version:

            messagebox.showinfo(
                "Yangilanish",
                "Sizda eng so‘nggi versiya o‘rnatilgan."
            )

            return

        result = messagebox.askyesno(
            "Yangi versiya",
            f"Yangi versiya mavjud: {latest_version}\n\n"
            "Yangilashni boshlaysizmi?"
        )

        if result:
            download_update(download_url)

    except Exception as e:

        messagebox.showerror(
            "Xatolik",
            f"Yangilanishni tekshirishda xatolik:\n\n{e}"
        )


def download_update(url):

    try:

        new_file = "MyApp_new.exe"

        response = requests.get(
            url,
            stream=True,
            timeout=60
        )

        response.raise_for_status()

        with open(new_file, "wb") as file:

            for chunk in response.iter_content(8192):

                if chunk:
                    file.write(chunk)

        # Hozirgi dastur joylashgan papka
        app_folder = os.path.dirname(
            os.path.abspath(sys.argv[0])
        )

        old_file = os.path.join(
            app_folder,
            "MyApp.exe"
        )

        new_file = os.path.join(
            app_folder,
            "MyApp_new.exe"
        )

        updater_file = os.path.join(
            app_folder,
            "Updater.exe"
        )

        app_file = old_file

        subprocess.Popen([
            updater_file,
            old_file,
            new_file,
            app_file
        ])

        window.destroy()

    except Exception as e:

        messagebox.showerror(
            "Xatolik",
            f"Yangilashda xatolik:\n\n{e}"
        )


window = tk.Tk()

window.title("MyApp")
window.geometry("500x350")
window.resizable(False, False)

title = tk.Label(
    window,
    text="Mening dasturim",
    font=("Arial", 24)
)

title.pack(pady=50)

version = tk.Label(
    window,
    text=f"Versiya: {VERSION}",
    font=("Arial", 11)
)

version.pack()

update_button = tk.Button(
    window,
    text="Yangilanishni tekshirish",
    command=check_update
)

update_button.pack(pady=30)

window.mainloop()
